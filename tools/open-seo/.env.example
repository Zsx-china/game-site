# Copy this file to .env and set the DataForSEO credential locally.
# Do not paste credentials into chat or commit the resulting .env file.
DATAFORSEO_API_KEY=

# The service is bound to this computer only by compose.yaml.
PORT=3001
OPENSEO_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1

# Optional features: leave blank unless you configure them later.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
